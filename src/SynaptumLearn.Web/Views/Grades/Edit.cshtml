@model SynaptumLearn.Web.Models.Grades.EditGradeViewModel

@{
    ViewData["Title"] = "Edit Grade";
}

<div class="container py-4">

    <div class="mb-4">
        <h2 class="fw-bold">Edit Grade</h2>

        <p class="text-muted mb-0">
            Update this curriculum grade.
        </p>
    </div>

    <div class="card border-0 shadow-sm">

        <div class="card-body">

            <form asp-action="Edit"                  asp-route-id="@Model.Id" method="post">

                @Html.AntiForgeryToken()

                <input asp-for="Id"                     type="hidden" />

                <div asp-validation-summary="ModelOnly"                    class="text-danger mb-3">
                </div>

                <div class="mb-3">

                    <label asp-for="Name"                          class="form-label">
                        Grade Name
                    </label>

                    <input asp-for="Name"        class="form-control" />

                    <span asp-validation-for="Name"            class="text-danger">
                    </span>

                </div>

                <div class="mb-4">

                    <label asp-for="Order"                  class="form-label">
                        Order
                    </label>

                    <input asp-for="Order"                           type="number" class="form-control" />

                    <span asp-validation-for="Order"          class="text-danger">
                    </span>

                </div>

                <div class="d-flex gap-2">

                    <button type="submit"                class="btn btn-primary">
                        Save Changes
                    </button>

                    <a asp-action="Details"                  asp-route-id="@Model.Id"                   class="btn btn-outline-secondary">
                        Cancel
                    </a>

                </div>

            </form>

        </div>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}