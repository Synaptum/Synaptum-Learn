@model SynaptumLearn.Web.Models.Grades.CreateGradeViewModel

@{
    ViewData["Title"] = "Create Grade";
}

<div class="container py-4">

    <div class="mb-4">
        <h2 class="fw-bold">Create Grade</h2>
        <p class="text-muted mb-0">
            Add a new grade to the curriculum catalogue.
        </p>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body">

            <form asp-action="Create" method="post">

                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly"                     class="text-danger mb-3">
                </div>

                <div class="mb-3">
                    <label asp-for="Name"                           class="form-label">
                        Grade Name
                    </label>

                    <input asp-for="Name"                           class="form-control"                           placeholder="e.g. Grade 12" />

                    <span asp-validation-for="Name"                          class="text-danger">
                    </span>
                </div>

                <div class="mb-4">
                    <label asp-for="Order"                           class="form-label">
                        Order
                    </label>

                    <input asp-for="Order" type="number" class="form-control" min="1" />

                    <span asp-validation-for="Order" class="text-danger">
                    </span>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary">
                        Create Grade
                    </button>

                    <a asp-action="Index" class="btn btn-outline-secondary">
                        Cancel
                    </a>
                </div>

            </form>

        </div>
    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}