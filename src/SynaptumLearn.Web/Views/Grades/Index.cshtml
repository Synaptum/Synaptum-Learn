@model IReadOnlyList<SynaptumLearn.Application.Curriculum.Grades.ListGrades.GradeListItemDto>

@{
    ViewData["Title"] = "Grades";
}

<div class="container-fluid py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">Grades</h2>

            <p class="text-muted mb-0">
                Curriculum grades available on Synaptum Learn.
            </p>

            <a asp-action="Create"   class="btn btn-primary">
                Create Grade
            </a>
        </div>
    </div>

    @if (Model.Count == 0)
    {
        <div class="card border-0 shadow-sm">
            <div class="card-body text-center py-5">

                <h5>No grades available</h5>

                <p class="text-muted mb-0">
                    No curriculum grades have been created yet.
                </p>

            </div>
        </div>
    }
    else
    {
        <div class="card border-0 shadow-sm">

            <div class="table-responsive">

                <table class="table table-hover align-middle mb-0">

                    <thead class="table-light">
                        <tr>
                            <th>Order</th>
                            <th>Grade</th>
                            <th>Created</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var grade in Model)
                        {
                            <tr>
                                <td>
                                    @grade.Order
                                </td>

                                <td class="fw-semibold">
                                    @grade.Name
                                </td>

                                <td>
                                    @grade.CreatedAt.ToString("yyyy-MM-dd")
                                </td>
                                <td class="text-end">
                                    <a asp-action="Details" asp-route-id="@grade.Id" class="btn btn-sm btn-outline-primary">
                                        Details
                                    </a>
                                </td>
                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>
    }

</div>