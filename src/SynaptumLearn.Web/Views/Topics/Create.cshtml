@model SynaptumLearn.Web.Models.Topics.CreateTopicViewModel

@{
    ViewData["Title"] = "Create Curriculum Topic";
}

<div class="container py-4">

    <div class="mb-4">
        <h2 class="fw-bold">Create Curriculum Topic</h2>
        <p class="text-muted mb-0">
            Add a topic to Prime Synaptum's official curriculum.
        </p>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body p-4">

            <form asp-controller="Topics"                  asp-action="Create" method="post">

                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly"                class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label asp-for="GradeSubjectId"                  class="form-label">
                        Grade and Subject
                    </label>

                    <select asp-for="GradeSubjectId"                      asp-items="Model.GradeSubjects"                            class="form-select">
                        <option value="">
                            -- Select grade and subject --
                        </option>
                    </select>

                    <span asp-validation-for="GradeSubjectId" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Title"    class="form-label">
                        Topic Title
                    </label>

                    <input asp-for="Title"      class="form-control"         placeholder="e.g. Algebraic Expressions" />

                    <span asp-validation-for="Title"          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Description"             class="form-label">
                        Description
                    </label>

                    <textarea asp-for="Description"                  class="form-control"                        rows="3"
                              placeholder="Briefly describe this topic"></textarea>

                    <span asp-validation-for="Description"      class="text-danger"></span>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="Term"            class="form-label">
                            Academic Term
                        </label>

                        <select asp-for="Term"                    asp-items="Model.Terms"  class="form-select">
                            <option value="">
                                -- Select term --
                            </option>
                        </select>

                        <span asp-validation-for="Term"       class="text-danger"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="Order"              class="form-label">
                            Topic Position
                        </label>

                        <input asp-for="Order"                    type="number"                           min="1"        class="form-control"              placeholder="e.g. 1" />

                        <span asp-validation-for="Order"                    class="text-danger"></span>
                    </div>
                </div>

                <div class="alert alert-info" role="note">
                    Topic positions determine the order of topics
                    within a subject and academic term.
                    Each position must be unique for that
                    grade-subject and term combination.
                </div>

                <div class="d-flex gap-2">
                    <button type="submit"                       class="btn btn-primary">
                        Create Topic
                    </button>

                    <a asp-controller="Topics"                      asp-action="Index"                    class="btn btn-outline-secondary">
                        Cancel
                    </a>
                </div>

            </form>

        </div>
    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}