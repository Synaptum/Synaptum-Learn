@model SynaptumLearn.Web.Models.Subjects.CreateSubjectViewModel

@{
    ViewData["Title"] = "Create Subject";
}

<div class="container py-4">

    <div class="mb-4">
        <h2 class="fw-bold">Create Subject</h2>
        <p class="text-muted mb-0">
            Add a new subject to the global curriculum catalogue.
        </p>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body">

            <form asp-action="Create" method="post">

                @Html.AntiForgeryToken()

                <div asp-validation-summary="All"           class="text-danger mb-3">
                </div>

                <div class="mb-3">
                    <label asp-for="Name" class="form-label">
                        Subject Name
                    </label>

                    <input asp-for="Name"                       class="form-control"                    placeholder="e.g. Life Sciences" />

                    <span asp-validation-for="Name"                class="text-danger">
                    </span>
                </div>

                <div class="mb-4">
                    <label asp-for="Code" class="form-label">
                        Subject Code
                    </label>

                    <input asp-for="Code"             class="form-control"          placeholder="e.g. LIFESCI" />

                    <span asp-validation-for="Code"      class="text-danger">
                    </span>
                </div>

                <div class="d-flex gap-2">

                    <button type="submit"    class="btn btn-primary">
                        Create Subject
                    </button>

                    <a asp-action="Index"            class="btn btn-outline-secondary">
                        Cancel
                    </a>

                </div>

            </form>

        </div>
    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}