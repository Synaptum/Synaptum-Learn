@model IReadOnlyList<SynaptumLearn.Application.Curriculum.Subjects.ListSubjects.SubjectListItemDto>

@{
    ViewData["Title"] = "Subjects";
}

<div class="container py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold">Subjects</h2>
            <p class="text-muted mb-0">
                Manage the global curriculum subject catalogue.
            </p>
            <a asp-controller="Subjects"   asp-action="Create"   class="btn btn-primary">
                Create Subject
            </a>
        </div>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body">

            <table class="table table-hover align-middle">
                <thead>
                    <tr>
                        <th>Subject Name</th>
                        <th>Code</th>
                        <th>Created</th>
                        <th>Actions</th>
                    </tr>
                </thead>

                <tbody>
                    @if (Model.Count == 0)
                    {
                        <tr>
                            <td colspan="4" class="text-center text-muted py-4">
                                No subjects have been created yet.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var subject in Model)
                        {
                            <tr>
                                <td>@subject.Name</td>
                                <td>
                                    <span class="badge bg-secondary">
                                        @subject.Code
                                    </span>
                                </td>
                                <td>
                                    @subject.CreatedAt.ToString("dd MMM yyyy")
                                </td>
                                <td>
                                    <a asp-controller="Subjects" asp-action="Details" asp-route-id="@subject.Id"
                                           class="btn btn-sm btn-outline-primary">
                                        Details
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>

        </div>
    </div>

</div>