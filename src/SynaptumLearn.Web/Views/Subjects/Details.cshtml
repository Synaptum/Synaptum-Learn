@model SynaptumLearn.Application.Curriculum.Subjects.GetSubjectDetails.SubjectDetailsDto

@{
    ViewData["Title"] = "Subject Details";
}

<div class="container py-4">

    <div class="mb-4">
        <h2 class="fw-bold">Subject Details</h2>
        <p class="text-muted mb-0">
            View information about this curriculum subject.
        </p>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body">

            <dl class="row mb-0">

                <dt class="col-sm-3">Subject Name</dt>
                <dd class="col-sm-9">@Model.Name</dd>

                <dt class="col-sm-3">Subject Code</dt>
                <dd class="col-sm-9">
                    <span class="badge bg-secondary">
                        @Model.Code
                    </span>
                </dd>

                <dt class="col-sm-3">Created</dt>
                <dd class="col-sm-9">
                    @Model.CreatedAt.ToString("dd MMM yyyy HH:mm")
                </dd>

                <dt class="col-sm-3">Last Modified</dt>
                <dd class="col-sm-9">
                    @(Model.LastModifiedAt.HasValue
                        ? Model.LastModifiedAt.Value.ToString("dd MMM yyyy HH:mm")
                        : "Not modified")
                </dd>

            </dl>

        </div>
    </div>

    <div class="mt-4">
        <a asp-action="Index" class="btn btn-outline-secondary">
            Back to Subjects
        </a>
        <a asp-action="Edit" asp-route-id="@Model.Id"   class="btn btn-primary">
            Edit Subject
        </a>
    </div>

</div>