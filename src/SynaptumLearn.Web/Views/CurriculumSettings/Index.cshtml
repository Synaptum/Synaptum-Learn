@model SynaptumLearn.Web.Models.CurriculumSettings.CurriculumSettingsViewModel
@using SynaptumLearn.Domain.Enums

@{
    ViewData["Title"] = "Curriculum Settings";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">

            <h2 class="mb-2">Curriculum Settings</h2>

            <p class="text-muted mb-4">
                Manage the current academic term and control
                which curriculum content learners can access.
            </p>

            @if (TempData["SuccessMessage"] is string successMessage)
            {
                <div class="alert alert-success" role="alert">
                    @successMessage
                </div>
            }

            <div class="card shadow-sm">
                <div class="card-body p-4">

                    <form asp-controller="CurriculumSettings"          asp-action="Index" method="post">

                        @Html.AntiForgeryToken()

                        <div asp-validation-summary="ModelOnly"             class="text-danger mb-3"></div>

                        <h5 class="mb-3">Current Academic Term</h5>

                        <div class="mb-4">
                            <label asp-for="CurrentTerm"                               class="form-label"></label>

                            <select asp-for="CurrentTerm"                                 class="form-select">
                                <option value="1">Term 1</option>
                                <option value="2">Term 2</option>
                                <option value="3">Term 3</option>
                                <option value="4">Term 4</option>
                            </select>

                            <span asp-validation-for="CurrentTerm"                                class="text-danger"></span>

                            <div class="form-text">
                                Select the academic term your school
                                is currently teaching.
                            </div>
                        </div>

                        <hr class="my-4" />

                        <h5 class="mb-3">Choose an access mode</h5>

                        <div class="form-check border rounded p-3 ps-5 mb-3">
                            <input asp-for="AccessMode"                                 class="form-check-input"                                 type="radio"                                  id="progressiveMode"
                                   value="@CurriculumAccessMode.Progressive" />

                            <label class="form-check-label" for="progressiveMode">
                                <strong>Progressive Access</strong>

                                <span class="d-block text-muted mt-1">
                                    Learners can access content from the
                                    current term and previous terms.
                                    Future terms remain unavailable.
                                </span>
                            </label>
                        </div>

                        <div class="form-check border rounded p-3 ps-5 mb-3">
                            <input asp-for="AccessMode" class="form-check-input"  type="radio"  id="fullYearMode"
                                   value="@CurriculumAccessMode.FullYear" />

                            <label class="form-check-label"      for="fullYearMode">
                                <strong>Full Year Access</strong>

                                <span class="d-block text-muted mt-1">
                                    Learners can access curriculum content
                                    from all four academic terms.
                                </span>
                            </label>
                        </div>

                        <span asp-validation-for="AccessMode" class="text-danger d-block mb-3"></span>

                        <div class="alert alert-info">
                            <strong>Important:</strong>
                            Under Progressive Access, the selected
                            academic term determines which terms
                            learners can access. Full Year Access
                            makes all four terms available.

                            Changing these settings does not override
                            lesson publication requirements or
                            sequential lesson unlocking rules.
                        </div>

                        <button type="submit"                class="btn btn-primary">
                            Save Settings
                        </button>

                    </form>

                </div>
            </div>

        </div>
    </div>
</div>