@model SynaptumLearn.Web.Models.GradeSubjects.AssignSubjectToGradeViewModel

@{
    ViewData["Title"] = "Assign Subject to Grade";
}

<div class="container py-4">

    <div class="mb-4">
        <h2 class="fw-bold">Assign Subject to Grade</h2>

        <p class="text-muted mb-0">
            Assign an existing subject to a grade in the global curriculum.
        </p>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body">

            <form asp-controller="GradeSubjects"      asp-action="Create"       method="post">

                @Html.AntiForgeryToken()

                <div asp-validation-summary="All"           class="text-danger mb-3">
                </div>

                <div class="mb-3">
                    <label asp-for="GradeId" class="form-label">
                        Grade
                    </label>

                    <select asp-for="GradeId"                      asp-items="Model.Grades"               class="form-select">

                        <option value="">-- Select Grade --</option>
                    </select>

                    <span asp-validation-for="GradeId"       class="text-danger">
                    </span>
                </div>

                <div class="mb-4">
                    <label asp-for="SubjectId" class="form-label">
                        Subject
                    </label>

                    <select asp-for="SubjectId"                            asp-items="Model.Subjects" class="form-select">

                        <option value="">-- Select Subject --</option>
                    </select>

                    <span asp-validation-for="SubjectId"                    class="text-danger">
                    </span>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary">
                        Assign Subject
                    </button>

                    <a asp-controller="GradeSubjects"        asp-action="Index"              class="btn btn-outline-secondary">
                        Cancel
                    </a>
                </div>

            </form>

        </div>
    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}