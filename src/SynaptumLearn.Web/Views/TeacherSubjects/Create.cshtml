@model SynaptumLearn.Web.Models.TeacherSubjects.AssignTeacherSubjectViewModel

@{
    ViewData["Title"] = "Assign Teacher to Subject";
}

<div class="container mt-4">
    <h2>Assign Teacher to Subject</h2>

    <p class="text-muted">
        Select a teacher and the grade-subject combination
        they will teach.
    </p>

    <form asp-action="Create"          asp-controller="TeacherSubjects"          method="post">

        @Html.AntiForgeryToken()

        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <div class="mb-3">
            <label asp-for="TeacherProfileId"    class="form-label">Teacher</label>

            <select asp-for="TeacherProfileId"          asp-items="Model.Teachers"                 class="form-select">
                <option value="">-- Select Teacher --</option>
            </select>

            <span asp-validation-for="TeacherProfileId"       class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="GradeSubjectId"            class="form-label">Grade and Subject</label>

            <select asp-for="GradeSubjectId"                  asp-items="Model.GradeSubjects"          class="form-select">
                <option value="">-- Select Grade and Subject --</option>
            </select>

            <span asp-validation-for="GradeSubjectId"                  class="text-danger"></span>
        </div>

        <button type="submit" class="btn btn-primary">
            Assign Teacher
        </button>

        <a asp-controller="SchoolUsers" asp-action="Index" class="btn btn-secondary">
            Cancel
        </a>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}