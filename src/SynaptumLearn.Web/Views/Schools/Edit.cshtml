@model SynaptumLearn.Web.Models.Schools.EditSchoolViewModel

@{
    ViewData["Title"] = "Edit School";
}

<div class="container py-4">
    <div class="mb-4">
        <h2 class="fw-bold">Edit School</h2>
        <p class="text-muted mb-0">
            Update the school's registration information.
        </p>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body">

            <form asp-action="Edit"      asp-route-id="@Model.Id"       method="post">

                @Html.AntiForgeryToken()

                <input asp-for="Id" type="hidden" />

                <div asp-validation-summary="ModelOnly"           class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label asp-for="Name"                      class="form-label"></label>

                    <input asp-for="Name"              class="form-control" />

                    <span asp-validation-for="Name"      class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="EMISNumber"                class="form-label"></label>

                    <input asp-for="EMISNumber"                          class="form-control" />

                    <span asp-validation-for="EMISNumber"                  class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Email"           class="form-label"></label>

                    <input asp-for="Email"    class="form-control" />

                    <span asp-validation-for="Email"                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Phone"                           class="form-label"></label>

                    <input asp-for="Phone"                           class="form-control" />

                    <span asp-validation-for="Phone"                          class="text-danger"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="Province"                           class="form-label"></label>

                    <select asp-for="Province" asp-items="Html.GetEnumSelectList<SynaptumLearn.Domain.Enums.Province>()"
                            class="form-select">
                    </select>

                    <span asp-validation-for="Province" class="text-danger"></span>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary">
                        Save Changes
                    </button>

                    <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary">
                        Cancel
                    </a>
                </div>

            </form>

        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}