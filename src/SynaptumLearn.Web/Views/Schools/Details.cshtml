@model SynaptumLearn.Application.Schools.GetSchoolDetails.SchoolDetailsDto

@{
    ViewData["Title"] = "School Details";
}

<div class="container-fluid py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">@Model.Name</h2>
            <p class="text-muted mb-0">@Model.Code</p>
        </div>
        <a asp-action="Edit" asp-route-id="@Model.Id" Class="btn btn-primary">
            Edit School
        </a>

        <a asp-action="Index" class="btn btn-outline-secondary">
            Back to Schools
        </a>
    </div>

    <div class="mt-4">
        <h5 class="mb-3">School Status</h5>

        <div class="d-flex gap-2 flex-wrap">

            @if (Model.Status == SynaptumLearn.Domain.Enums.SchoolStatus.Pending)
            {
                <form asp-action="ChangeStatus" method="post">
                    @Html.AntiForgeryToken()

                    <input type="hidden" name="id" value="@Model.Id" />
                    <input type="hidden" name="newStatus" value="@SynaptumLearn.Domain.Enums.SchoolStatus.Active" />

                    <button type="submit" class="btn btn-success">
                        Activate
                    </button>
                </form>

                <form asp-action="ChangeStatus" method="post">
                    @Html.AntiForgeryToken()

                    <input type="hidden" name="id" value="@Model.Id" />
                    <input type="hidden" name="newStatus" value="@SynaptumLearn.Domain.Enums.SchoolStatus.Archived" />

                    <button type="submit" class="btn btn-outline-danger">
                        Archive
                    </button>
                </form>
            }

            @if (Model.Status == SynaptumLearn.Domain.Enums.SchoolStatus.Active)
            {
                <form asp-action="ChangeStatus" method="post">
                    @Html.AntiForgeryToken()

                    <input type="hidden" name="id" value="@Model.Id" />
                    <input type="hidden" name="newStatus" value="@SynaptumLearn.Domain.Enums.SchoolStatus.Suspended" />

                    <button type="submit" class="btn btn-warning">
                        Suspend
                    </button>
                </form>

                <form asp-action="ChangeStatus" method="post">
                    @Html.AntiForgeryToken()

                    <input type="hidden" name="id" value="@Model.Id" />
                    <input type="hidden" name="newStatus" value="@SynaptumLearn.Domain.Enums.SchoolStatus.Archived" />

                    <button type="submit" class="btn btn-outline-danger">
                        Archive
                    </button>
                </form>
            }

            @if (Model.Status == SynaptumLearn.Domain.Enums.SchoolStatus.Suspended)
            {
                <form asp-action="ChangeStatus" method="post">
                    @Html.AntiForgeryToken()

                    <input type="hidden" name="id" value="@Model.Id" />
                    <input type="hidden" name="newStatus" value="@SynaptumLearn.Domain.Enums.SchoolStatus.Active" />

                    <button type="submit" class="btn btn-success">
                        Reactivate
                    </button>
                </form>

                <form asp-action="ChangeStatus" method="post">
                    @Html.AntiForgeryToken()

                    <input type="hidden" name="id" value="@Model.Id" />
                    <input type="hidden" name="newStatus" value="@SynaptumLearn.Domain.Enums.SchoolStatus.Archived" />

                    <button type="submit" class="btn btn-outline-danger">
                        Archive
                    </button>
                </form>
            }

            @if (Model.Status == SynaptumLearn.Domain.Enums.SchoolStatus.Archived)
            {
                <span class="text-muted">
                    This school has been archived and cannot change status.
                </span>
            }

        </div>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body">

            <dl class="row mb-0">

                <dt class="col-sm-3">School Code</dt>
                <dd class="col-sm-9">@Model.Code</dd>

                <dt class="col-sm-3">EMIS Number</dt>
                <dd class="col-sm-9">@Model.EMISNumber</dd>

                <dt class="col-sm-3">Email</dt>
                <dd class="col-sm-9">@Model.Email</dd>

                <dt class="col-sm-3">Phone</dt>
                <dd class="col-sm-9">@Model.Phone</dd>

                <dt class="col-sm-3">Province</dt>
                <dd class="col-sm-9">@Model.Province</dd>

                <dt class="col-sm-3">Status</dt>
                <dd class="col-sm-9">@Model.Status</dd>

                <dt class="col-sm-3">Slug</dt>
                <dd class="col-sm-9">@Model.Slug</dd>

                <dt class="col-sm-3">Created</dt>
                <dd class="col-sm-9">@Model.CreatedAt</dd>

                <dt class="col-sm-3">Last Modified</dt>
                <dd class="col-sm-9">
                    @(Model.LastModifiedAt?.ToString() ?? "Never")
                </dd>

            </dl>

        </div>
    </div>

</div>