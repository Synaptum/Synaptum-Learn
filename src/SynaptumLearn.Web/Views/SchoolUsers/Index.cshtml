@model IReadOnlyList<SynaptumLearn.Application.Users.ListSchoolUsers.SchoolUserListItemDto>

@{
    ViewData["Title"] = "School User Management";

    var teachers = Model.Where(u => u.AccountType == "Teacher").ToList();
    var learners = Model.Where(u => u.AccountType == "Learner").ToList();
}


@if (TempData["SuccessMessage"] is string successMessage)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="fas fa-check-circle me-2"></i>
        @successMessage

        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close">
        </button>
    </div>
}

<div class="container py-4">

    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <h2 class="mb-1">School User Management</h2>
            <p class="text-muted mb-0">
                Manage teachers and learners at your school.
            </p>
        </div>

        <div class="d-flex gap-2">
            <a asp-action="CreateTeacher" class="btn btn-primary">
                Add Teacher
            </a>

            <a asp-action="CreateLearner" class="btn btn-outline-primary">
                Add Learner
            </a>

            <a asp-controller="TeacherSubjects" asp-action="Index" class="btn btn-outline-primary">
                <i class="fas fa-book me-1"></i>
                Teacher Assignments
            </a>

        </div>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-md-6">
            <div class="card shadow-sm">
                <div class="card-body">
                    <p class="text-muted mb-1">Teachers</p>
                    <h3 class="mb-0">@teachers.Count</h3>
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card shadow-sm">
                <div class="card-body">
                    <p class="text-muted mb-1">Learners</p>
                    <h3 class="mb-0">@learners.Count</h3>
                </div>
            </div>
        </div>
    </div>

    <h4 class="mb-3">Teachers</h4>

    <div class="table-responsive mb-5">
        <table class="table table-striped table-hover align-middle">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Email</th>
                    <th>Employee Number</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var teacher in teachers)
                {
                    <tr>
                        <td>@teacher.FirstName @teacher.LastName</td>
                        <td>@teacher.Email</td>
                        <td>@teacher.Number</td>
                        <td>
                            @if (teacher.IsActive)
                            {
                                <span class="badge bg-success">Active</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Inactive</span>
                            }
                        </td>
                    </tr>
                }

                @if (teachers.Count == 0)
                {
                    <tr>
                        <td colspan="4" class="text-muted text-center py-4">
                            No teachers registered yet.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <h4 class="mb-3">Learners</h4>

    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Email</th>
                    <th>Learner Number</th>
                    <th>Grade</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var learner in learners)
                {
                    <tr>
                        <td>@learner.FirstName @learner.LastName</td>
                        <td>@learner.Email</td>
                        <td>@learner.Number</td>
                        <td>@learner.Grade</td>
                        <td>
                            @if (learner.IsActive)
                            {
                                <span class="badge bg-success">Active</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Inactive</span>
                            }
                        </td>
                    </tr>
                }

                @if (learners.Count == 0)
                {
                    <tr>
                        <td colspan="5" class="text-muted text-center py-4">
                            No learners registered yet.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

</div>