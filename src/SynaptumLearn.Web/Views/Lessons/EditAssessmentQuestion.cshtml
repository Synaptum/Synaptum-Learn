@model SynaptumLearn.Web.Models.Assessments.EditAssessmentQuestionViewModel

@{
    ViewData["Title"] = "Edit Assessment Question";
}

<div class="container py-4">

    <h2>Edit Assessment Question</h2>

    <p class="text-muted">
        Question @Model.Order
    </p>

    <form asp-action="EditAssessmentQuestion" method="post">
        @Html.AntiForgeryToken()

        <input asp-for="QuestionId" type="hidden" />
        <input asp-for="AssessmentId" type="hidden" />
        <input asp-for="Order" type="hidden" />

        <div asp-validation-summary="All"        class="text-danger mb-3"></div>

        <div class="mb-3">
            <label asp-for="Text" class="form-label">
                Question Text
            </label>

            <textarea asp-for="Text"                  class="form-control"               rows="5"></textarea>

            <span asp-validation-for="Text"        class="text-danger"></span>
        </div>

        <div class="mb-4">
            <label asp-for="Marks" class="form-label">
                Marks
            </label>

            <input asp-for="Marks"  type="number"         min="1"                class="form-control" />

            <span asp-validation-for="Marks"         class="text-danger"></span>
        </div>

        <div class="d-flex gap-2">
            <button type="submit"    class="btn btn-primary">
                Save Changes
            </button>

            <a asp-action="ManageMasteryAssessment"       asp-route-id="@Model.AssessmentId"
                   class="btn btn-outline-secondary">
                Cancel
            </a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}