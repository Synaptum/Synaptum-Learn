@model SynaptumLearn.Web.Models.Lessons.AddLessonContentViewModel
@using SynaptumLearn.Domain.Content

@{
    ViewData["Title"] = "Add Lesson Content";
}

<div class="container py-4">
    <h1 class="h3 mb-2">Add Content Block</h1>

    <p class="text-muted mb-4">
        Lesson: @Model.LessonTitle
    </p>

    <form asp-action="AddContent" method="post">
        @Html.AntiForgeryToken()

        <input asp-for="LessonId" type="hidden" />

        <div asp-validation-summary="ModelOnly"          class="text-danger mb-3"></div>

        <div class="mb-3">
            <label asp-for="Type" class="form-label">
                Content Type
            </label>

            <select asp-for="Type"                    asp-items="Html.GetEnumSelectList<LessonContentType>()"                   class="form-select">
                <option value="">Select content type</option>
            </select>

            <span asp-validation-for="Type"                class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Title" class="form-label"></label>

            <input asp-for="Title"               class="form-control"             maxlength="200" />

            <span asp-validation-for="Title"           class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Content" class="form-label"></label>

            <textarea asp-for="Content"            class="form-control"              rows="8"               maxlength="10000"></textarea>

            <span asp-validation-for="Content"             class="text-danger"></span>

            <div class="form-text">
                Enter text, a mathematical expression,
                or a resource URL depending on the selected type.
            </div>
        </div>

        <div class="mb-3">
            <label asp-for="Order" class="form-label"></label>

            <input asp-for="Order"           type="number"          min="1"        class="form-control" />

            <span asp-validation-for="Order"      class="text-danger"></span>
        </div>

        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-primary">
                Save Content Block
            </button>

            <a asp-action="ManageContent"               asp-route-id="@Model.LessonId" class="btn btn-outline-secondary">
                Cancel
            </a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}