@model SynaptumLearn.Web.Models.Assessments.AddAssessmentQuestionViewModel

@{
    ViewData["Title"] = "Add Assessment Question";
}

<div class="container py-4">

    <h2>Add Assessment Question</h2>

    <p class="text-muted">
        Assessment: @Model.AssessmentTitle
    </p>

    <form asp-action="AddAssessmentQuestion" method="post">
        @Html.AntiForgeryToken()

        <input asp-for="AssessmentId" type="hidden" />

        <div asp-validation-summary="All"             class="text-danger mb-3"></div>

        <div class="mb-3">
            <label asp-for="Text" class="form-label">
                Question
            </label>

            <textarea asp-for="Text"                      class="form-control"                      rows="4"></textarea>

            <span asp-validation-for="Text" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Marks" class="form-label"></label>
            <input asp-for="Marks" type="number" min="1"             class="form-control" />
            <span asp-validation-for="Marks"               class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Order" class="form-label"></label>
            <input asp-for="Order"                  type="number"     min="1"        class="form-control" />
            <span asp-validation-for="Order"           class="text-danger"></span>
        </div>

        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-primary">
                Save Question
            </button>

            <a asp-action="ManageMasteryAssessment"          asp-route-id="@Model.AssessmentId"
                   class="btn btn-outline-secondary">
                Cancel
            </a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}