@model IReadOnlyList<SynaptumLearn.Application.Curriculum.Lessons.ListLessons.LessonListItemDto>

@{
    ViewData["Title"] = "Lesson Management";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3">Lesson Management</h1>
            <p class="text-muted mb-0">
                Manage Prime Synaptum's official curriculum lessons.
            </p>
        </div>

        <a asp-action="Create" class="btn btn-primary">
            Create Lesson
        </a>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            No lessons have been created yet.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped align-middle">
                <thead>
                    <tr>
                        <th>Topic</th>
                        <th>Lesson</th>
                        <th>Order</th>
                        <th>Status</th>
                        <th>Published</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var lesson in Model)
                    {
                        <tr>
                            <td>@lesson.TopicTitle</td>
                            <td>
                                <strong>@lesson.Title</strong>
                                <div class="small text-muted">
                                    @lesson.Summary
                                </div>
                            </td>
                            <td>@lesson.Order</td>
                            <td>@lesson.Status</td>
                            <td>
                                @(lesson.PublishedAt?.ToString("dd MMM yyyy") ?? "—")
                            </td>
                            <td>
                                <a asp-action="Edit" asp-route-id="@lesson.Id" class="btn btn-sm btn-outline-primary">
                                    Edit
                                </a>
                                <a asp-action="ManageContent"                    asp-route-id="@lesson.Id"
                                       class="btn btn-sm btn-outline-secondary">
                                    Manage Content
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>