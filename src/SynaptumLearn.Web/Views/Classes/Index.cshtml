@model IReadOnlyList<SynaptumLearn.Application.Classes.ListClasses.ClassListItemDto>

@{
    ViewData["Title"] = "Class Management";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Class Management</h2>

        <a asp-action="Create" class="btn btn-primary">
            Create Class
        </a>
    </div>

    @if (TempData["SuccessMessage"] is string message)
    {
        <div class="alert alert-success" role="alert">
            @message
        </div>
    }

    @if (Model.Count == 0)
    {
        <div class="alert alert-info">
            No classes have been created for this school yet.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover">
                <thead>
                    <tr>
                        <th>Class</th>
                        <th>Grade</th>
                        <th>Academic Year</th>
                        <th>Learners</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var schoolClass in Model)
                    {
                        <tr>
                            <td>@schoolClass.Name</td>
                            <td>@schoolClass.GradeName</td>
                            <td>@schoolClass.AcademicYear</td>
                            <td>@schoolClass.LearnerCount</td>
                            <td>
                                <div class="d-flex gap-2">
                                    <a asp-action="Roster" asp-route-classId="@schoolClass.Id"
                                           class="btn btn-sm btn-outline-secondary">
                                        View Learners
                                    </a>

                                    <a asp-action="Enroll" asp-route-classId="@schoolClass.Id"
                                           class="btn btn-sm btn-outline-primary">
                                        Enroll Learner
                                    </a>

                                    <a asp-action="AssignTeacher" asp-route-classId="@schoolClass.Id"
                                           class="btn btn-sm btn-outline-primary">
                                        Assign Teacher
                                    </a>

                                    <a asp-action="Teachers"                          asp-route-classId="@schoolClass.Id"
                                           class="btn btn-sm btn-outline-secondary">
                                        View Teachers
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>