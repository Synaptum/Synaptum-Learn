@model SynaptumLearn.Web.Models.Classes.ClassTeachersViewModel

@{
    ViewData["Title"] = "Class Teachers";
}

<div class="container mt-4">
    <h2>Class Teachers</h2>

    <div class="card mb-4">
        <div class="card-body">
            <h5>@Model.ClassName</h5>

            <p class="mb-1">
                <strong>Grade:</strong> @Model.GradeName
            </p>

            <p class="mb-0">
                <strong>Academic Year:</strong> @Model.AcademicYear
            </p>
        </div>
    </div>

    @if (Model.Teachers.Count == 0)
    {
        <div class="alert alert-info">
            No teachers have been assigned to this class yet.
        </div>
    }
    else
    {
        @if (TempData["SuccessMessage"] is string successMessage)
        {
            <div class="alert alert-success">
                @successMessage
            </div>
        }
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>Teacher</th>
                    <th>Subject</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var teacher in Model.Teachers)
                {
                    <tr>
                        <td>@teacher.TeacherName</td>
                        <td>@teacher.SubjectName</td>
                        <td>
                            <form asp-action="RemoveTeacher" method="post">
                                @Html.AntiForgeryToken()

                                <input type="hidden" name="assignmentId" value="@teacher.AssignmentId" />

                                <input type="hidden" name="classId" value="@Model.ClassId" />

                                <button type="submit" class="btn btn-sm btn-outline-danger"
                                        onclick="return confirm('Remove this teacher from the class?');">
                                    Remove
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }

    <div class="mt-3">
        <a asp-action="AssignTeacher" asp-route-classId="@Model.ClassId" class="btn btn-primary">
            Assign Another Teacher
        </a>

        <a asp-action="Index" class="btn btn-secondary">
            Back to Classes
        </a>
    </div>
</div>