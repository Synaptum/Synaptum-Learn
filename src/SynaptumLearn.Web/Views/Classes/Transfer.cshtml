@model SynaptumLearn.Web.Models.Classes.TransferLearnerViewModel

@{
    ViewData["Title"] = "Transfer Learner";
}

<div class="container mt-4">
    <h2>Transfer Learner</h2>

    <p class="text-muted">
        Move a learner to another class without deleting
        their previous enrollment record.
    </p>

    <div class="card mb-4">
        <div class="card-body">
            <h5 class="card-title">@Model.LearnerName</h5>

            <p class="mb-1">
                <strong>Learner Number:</strong>
                @Model.LearnerNumber
            </p>

            <p class="mb-1">
                <strong>Current Class:</strong>
                @Model.SourceClassName
            </p>

            <p class="mb-1">
                <strong>Grade:</strong>
                @Model.GradeName
            </p>

            <p class="mb-0">
                <strong>Academic Year:</strong>
                @Model.AcademicYear
            </p>
        </div>
    </div>

    <form asp-action="Transfer" method="post">
        @Html.AntiForgeryToken()

        <input asp-for="EnrollmentId" type="hidden" />

        <div asp-validation-summary="ModelOnly"         class="text-danger mb-3"></div>

        <div class="mb-3">
            <label asp-for="DestinationClassId"                  class="form-label">
                Destination Class
            </label>

            <select asp-for="DestinationClassId"                asp-items="Model.DestinationClasses"              class="form-select">
                <option value="">-- Select Destination Class --</option>
            </select>

            <span asp-validation-for="DestinationClassId"           class="text-danger"></span>
        </div>

        @if (Model.DestinationClasses.Count == 0)
        {
            <div class="alert alert-info">
                No alternative classes are available for this
                grade and academic year.
            </div>
        }

        <button type="submit"          class="btn btn-primary"                disabled="@(Model.DestinationClasses.Count == 0)">
            Transfer Learner
        </button>

        <a asp-action="Roster"     asp-route-classId="@Model.SourceClassId"      class="btn btn-secondary">
            Cancel
        </a>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}