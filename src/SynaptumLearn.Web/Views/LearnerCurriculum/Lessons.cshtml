@model IReadOnlyList<SynaptumLearn.Application.Curriculum.LearnerCurriculum.LearnerLessonDto>

@{
    ViewData["Title"] = "My Lessons";

    var completedCount = Model.Count(lesson => lesson.IsCompleted);
    var totalCount = Model.Count;
    var completionPercentage = totalCount == 0
        ? 0
        : (int)Math.Round(completedCount * 100.0 / totalCount);
}

<div class="container py-4">

    <div class="mb-4">
        <a asp-controller="LearnerCurriculum" asp-action="Index"       class="text-decoration-none">
            &larr; Back to My Curriculum
        </a>
    </div>

    <div class="mb-4">
        <h1 class="h2">My Lessons</h1>
        <p class="text-muted">
            Complete the required assessments to unlock
            the next lessons.
        </p>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-secondary">
            No published lessons are currently available
            for this topic.
        </div>
    }
    else
    {
        <div class="card shadow-sm mb-4">
            <div class="card-body">

                <div class="d-flex justify-content-between mb-2">
                    <strong>Lesson Progress</strong>
                    <span>@completedCount of @totalCount completed</span>
                </div>

                <div class="progress"                     role="progressbar"                 aria-label="Lesson completion"
                     aria-valuenow="@completionPercentage"                  aria-valuemin="0"              aria-valuemax="100">

                    <div class="progress-bar bg-success"                  style="width: @(completionPercentage)%">
                    </div>
                </div>

                <p class="small text-muted mt-2 mb-0">
                    @completionPercentage% completed
                </p>

            </div>
        </div>

        <div class="row g-3">

            @foreach (var lesson in Model)
            {
                var isLocked = !lesson.IsUnlocked;

                var statusText = lesson.IsCompleted
                    ? "Completed"
                    : isLocked
                        ? "Locked"
                        : "Unlocked";

                var statusClass = lesson.IsCompleted
                    ? "bg-success"
                    : isLocked
                        ? "bg-secondary"
                        : "bg-primary";

                <div class="col-12">
                    <div class="card shadow-sm @(isLocked ? "bg-light" : "")">

                        <div class="card-body">

                            <div class="d-flex justify-content-between
                                align-items-start gap-3">

                                <div>
                                    <p class="small text-muted mb-1">
                                        Lesson @lesson.Order
                                    </p>

                                    <h2 class="h5 mb-2">
                                        @lesson.Title
                                    </h2>

                                    @if (!string.IsNullOrWhiteSpace(lesson.Summary))
                                    {
                                        <p class="text-muted mb-0">
                                            @lesson.Summary
                                        </p>
                                    }
                                </div>

                                <span class="badge @statusClass">
                                    @statusText
                                </span>

                            </div>

                            <div class="mt-3">

                                @if (lesson.IsCompleted)
                                {
                                    <p class="text-success small mb-0">
                                        You have completed this lesson.
                                    </p>
                                }
                                else if (isLocked)
                                {
                                    <p class="text-muted small mb-0">
                                        Complete the required assessment
                                        in the previous lesson to unlock this lesson.
                                    </p>
                                }
                                else
                                {
                                    <p class="text-primary small mb-0">
                                        This lesson is available to study.
                                    </p>
                                }

                            </div>

                        </div>
                    </div>
                </div>
            }

        </div>
    }

</div>